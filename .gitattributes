# Normalize text files to LF across platforms.
* text=auto eol=lf

# Explicit text formats used by the project.
*.md text eol=lf
*.mdx text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.graphql text eol=lf
*.gql text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.editorconfig text eol=lf
*.lock text eol=lf
pnpm-lock.yaml text eol=lf

# Binary assets must not be normalized as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp4 binary
*.webm binary
*.mov binary
*.mp3 binary
*.wav binary
*.ogg binary
*.flac binary
*.m4a binary
*.aac binary
*.psd binary
*.ai binary
*.zip binary
*.gz binary
*.br binary
*.wasm binary

# GitHub and package-manager lockfiles remain text for useful diffs.
package-lock.json text eol=lf
yarn.lock text eol=lf
