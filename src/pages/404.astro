---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Motif">
  <div class="mx-auto max-w-3xl px-6 py-20 sm:py-28">
    <p class="text-xs font-medium uppercase tracking-[0.2em] text-neutral-500">404</p>
    <h1 class="mt-5 text-3xl font-semibold tracking-tight sm:text-4xl">Page not found</h1>
    <p class="mt-4 text-neutral-600">The requested page does not exist.</p>
    <p class="mt-8">
      <a class="underline underline-offset-4 hover:text-neutral-900" href="/">Return to the homepage</a>
    </p>
  </div>
</BaseLayout>
