---
import BaseLayout from '../layouts/BaseLayout.astro';

const approaches = [
  {
    name: 'Hugin',
    summary: 'Editorial expression, presentation, reading, and communication.',
    concerns: [
      'Content hierarchy and narrative structure',
      'Typography and reading experience',
      'Visual emphasis and information presentation',
    ],
  },
  {
    name: 'Munin',
    summary: 'Content creation, organization, management, and operation.',
    concerns: [
      'Information architecture and navigation',
      'Workspaces and operational workflows',
      'Controls and interaction states',
    ],
  },
];

const appearances = [
  {
    name: 'Motif',
    summary: 'The light appearance and initial visual foundation.',
  },
  {
    name: 'Motif Dark',
    summary: 'An independently designed dark appearance, not a color inversion.',
  },
];

const areas = [
  {
    href: '/docs/',
    title: 'Documentation',
    summary: 'Principles, design approaches, appearance modes, and implementation guidance.',
  },
  {
    href: '/blog/',
    title: 'Blog',
    summary: 'Design research, technical practice, and project updates.',
  },
];
---

<BaseLayout title="Motif — a cross-media, cross-platform design system">
  <div class="mx-auto max-w-3xl px-6 py-20 sm:py-28">
    <header>
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-neutral-500">
        P0 — Development Foundation
      </p>
      <h1 class="mt-5 text-4xl font-semibold tracking-tight sm:text-6xl">Motif</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-neutral-600 sm:text-xl">
        A design system for creating, organizing, expressing, presenting, and distributing
        content — across media and platforms, without forcing every platform into the same
        implementation model.
      </p>
    </header>

    <section class="mt-16 sm:mt-20" aria-labelledby="approaches-heading">
      <h2
        id="approaches-heading"
        class="text-xs font-medium uppercase tracking-[0.2em] text-neutral-500"
      >
        Two approaches
      </h2>
      <div class="mt-6 grid gap-8 sm:grid-cols-2">
        {
          approaches.map((approach) => (
            <article>
              <h3 class="text-xl font-semibold tracking-tight">{approach.name}</h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-600">{approach.summary}</p>
              <ul class="mt-4 space-y-1 text-sm text-neutral-600">
                {approach.concerns.map((concern) => (
                  <li>{concern}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-16 sm:mt-20" aria-labelledby="appearances-heading">
      <h2
        id="appearances-heading"
        class="text-xs font-medium uppercase tracking-[0.2em] text-neutral-500"
      >
        Appearance modes
      </h2>
      <p class="mt-6 max-w-2xl text-sm leading-relaxed text-neutral-600">
        Motif and Motif Dark are two appearance modes of the same design system. The design
        approaches are independent of the appearance; both work coherently in both modes.
      </p>
      <ul class="mt-6 space-y-2 text-sm">
        {
          appearances.map((appearance) => (
            <li>
              <span class="font-medium text-neutral-900">{appearance.name}</span>
              <span class="text-neutral-600"> — {appearance.summary}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-16 sm:mt-20" aria-labelledby="areas-heading">
      <h2 id="areas-heading" class="text-xs font-medium uppercase tracking-[0.2em] text-neutral-500">
        Explore
      </h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          areas.map((area) => (
            <a
              href={area.href}
              class="group rounded-lg border border-neutral-200 p-5 transition-colors hover:border-neutral-400"
            >
              <h3 class="text-base font-semibold tracking-tight group-hover:underline">
                {area.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-neutral-600">{area.summary}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="mt-16 sm:mt-20" aria-labelledby="status-heading">
      <h2 id="status-heading" class="text-xs font-medium uppercase tracking-[0.2em] text-neutral-500">
        Status
      </h2>
      <p class="mt-6 max-w-2xl text-sm leading-relaxed text-neutral-600">
        The website, documentation, and blog are being built inside one Astro project. Documentation
        and blog pages are now generated from Astro Content Collections; the site is still a P0
        foundation ahead of P1 — Real Web Presence.
      </p>
    </section>
  </div>
</BaseLayout>
