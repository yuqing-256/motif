---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const docs = (await getCollection('docs')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout
  title="Documentation — Motif"
  description="Design principles, foundations, and implementation guidance for Motif."
>
  <div class="mx-auto max-w-3xl px-6 py-16 sm:py-20">
    <p class="text-xs font-medium uppercase tracking-[0.2em] text-neutral-500">Documentation</p>
    <h1 class="mt-5 text-3xl font-semibold tracking-tight sm:text-4xl">Documentation</h1>
    <p class="mt-4 max-w-2xl text-neutral-600">
      Design principles, foundations, themes, and implementation guidance for Motif. This area is
      being established in P1 — the pages here are the initial content model.
    </p>

    <ul class="mt-10 divide-y divide-neutral-200 border-y border-neutral-200">
      {
        docs.map((doc) => (
          <li class="py-6">
            <a href={`/docs/${doc.id}/`} class="group block">
              <h2 class="text-lg font-semibold tracking-tight group-hover:underline">
                {doc.data.title}
              </h2>
              <p class="mt-1 text-sm leading-relaxed text-neutral-600">{doc.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
